<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap mp rescap">

  <Identity
    Name="YuGiOhForbiddenMemoriesUWP"
    Publisher="CN=Antigravity"
    Version="1.1.0.3"
    ProcessorArchitecture="x64" />

  <mp:PhoneIdentity PhoneProductId="a8f27618-971c-4b6e-826c-0e86b245a4a3" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Yu-Gi-Oh! Forbidden Memories</DisplayName>
    <PublisherDisplayName>Yu-Gi-Oh! Forbidden Memories</PublisherDisplayName>
    <Logo>Assets\YuGiOhStoreLogo.png</Logo>
    <Description>Yu-Gi-Oh! Forbidden Memories Recompiled for Xbox Series S/X and Windows 10/11.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
    <TargetDeviceFamily Name="Windows.Xbox" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="YuGiOhForbiddenMemoriesUWP.App">
      <uap:VisualElements
        DisplayName="Yu-Gi-Oh! Forbidden Memories"
        Description="Yu-Gi-Oh! Forbidden Memories Recompiled (DirectX 12)"
        BackgroundColor="#000000"
        Square150x150Logo="Assets\YuGiOhIcon150.png"
        Square44x44Logo="Assets\YuGiOhIcon44.png">
        <uap:DefaultTile Wide310x150Logo="Assets\YuGiOhWideLogo.png" Square310x310Logo="Assets\YuGiOhIcon310.png" ShortName="Yu-Gi-Oh! FM">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\YuGiOhSplashScreen.png" BackgroundColor="#000000" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="codeGeneration" />
    <rescap:Capability Name="broadFileSystemAccess" />
  </Capabilities>
</Package>
